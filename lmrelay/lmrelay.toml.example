# lmrelay configuration.
#
# Looked for, first hit wins:
#   $LMRELAY_CONFIG  ->  ./lmrelay.toml  ->  ~/.lmrelay/lmrelay.toml
#
# This file belongs to you. The CLI never rewrites it, so the comments below
# survive every command. Caller tokens and CLI-added providers go to
# state.json beside it, which is machine-owned. 'lmrelay import'
# is the one exception, and it backs this file up before replacing it.
#
# Settings are here and in state.json, and nowhere else. There is no
# environment spelling for any of them: $LMRELAY_CONFIG names which file to
# read, and that is the whole of what the environment decides.
#
# ${VAR} in any header value is read from the process environment, so API
# keys can stay out of this file.

# host, port and connect_timeout are read at startup only; changing any of them
# needs 'lmrelay restart'. The rest of this file is picked up by 'lmrelay reload'.
[server]
host             = "127.0.0.1"   # 0.0.0.0 only with auth on
port             = 11435         # beside Ollama, which keeps 11434; point
                                 # clients at 11435 instead
default_upstream = "ollama"      # used when the path has no upstream prefix
connect_timeout  = 10            # seconds to reach the upstream; there is
                                 # deliberately no read timeout (see README)
log_level        = "INFO"

# Limits. Three scopes, one number each, every one 0 (off) by default: a relay
# in front of one operator's own Ollama has nobody to limit, and a limit nobody
# chose is a refusal nobody expects.
#
#   requests  how many a caller may have in flight at once, 0 off. A streamed
#             answer holds its slot until its last byte, and there is no read
#             timeout, so one slow generation can hold one for minutes
#   period    add one and the same number is also how many they may START in
#             that long: requests = 10 with period = "30m" is ten every half
#             hour, of which ten may arrive together. "0s" is no such limit
#
# One number rather than three. "Ten at a time" and "ten every half hour" are
# the same operator saying how much of this machine one caller gets, and the
# separate burst this replaced was a third number whose only job was to be
# wrong. A period is a whole number and a unit, one of s, m or h; a bare number
# is refused, because "30" is half an hour to whoever wrote it about as often
# as it is half a minute.
#
# Editable here, or from the command line, which writes into these same tables
# and signals a running relay:
#
#   lmrelay limits set total 1              one at a time
#   lmrelay limits set total 1 60s          one a minute, and one at a time
#   lmrelay limits set per_address 10 30m   ten every half hour
#   lmrelay limits set total 0              off
#   lmrelay status                          what is in force right now
#
# It replaces the values on their own lines and leaves the rest of this file
# alone, these comments included.
#
# A request must pass every scope you set, and is charged to all of them or to
# none of them, so a refusal costs nothing anywhere: being turned away by one
# scope does not also drain the allowance of the others. They are not
# alternatives; leave the ones you do not want at 0.
#
# If you set exactly one number, set [limits.total]. That is the one that
# protects the machine; the other two apportion what it admits.
#
# The counts live in memory in this one process, so a second relay beside this
# one counts its own callers, and a client reaching both has both allowances.
# That includes [limits.total], which is worse, because total is the scope
# protecting the upstream.

# Per credential. Skipped entirely with auth off, since there is then no
# credential to key on, and two machines sharing a token are one caller sharing
# one allowance. Set this beside total for fairness: total on its own is first
# come first served, and one client with fifty threads owns all of it.
[limits.per_token]
requests = 0
period   = "0s"

# Per client address. The only scope that identifies anyone with auth off, and
# only as trustworthy as whatever sets X-Forwarded-For in front of the relay.
# An address behind NAT is many callers wearing one number, so this limits the
# office rather than the offender.
[limits.per_address]
requests = 0
period   = "0s"

# The relay as a whole, whoever is asking. This is the one that protects the
# upstream: ten callers each inside their own limit still arrive together, and
# a per-caller cap cannot see that. Sizing it above
# OLLAMA_NUM_PARALLEL x OLLAMA_MAX_LOADED_MODELS buys nothing, because past
# that point Ollama queues internally and the queued request holds its relay
# slot the whole time it is receiving nothing.
[limits.total]
requests = 0
period   = "0s"

# Caller credentials are not configured here. They live in state.json and are
# managed by the CLI:
#
#   lmrelay token gen           mint one and print it once
#   lmrelay token list          show what exists, masked
#   lmrelay auth true | false   the switch; with auth off lmrelay is a plain
#                               transparent proxy in front of Ollama
#
# The switch lives in state.json rather than here, because it is a decision the
# CLI makes and this file is yours.
#
# A token written below is accepted as one extra valid credential, which is how
# an install that never runs the CLI injects one. It does not turn checking on;
# only 'lmrelay auth true' does.
#
# [auth]
# token = "CHANGE-ME"


# Local Ollama, exactly where it already listens. Needs no credential, so it
# has no headers at all.
[upstream.ollama]
base_url = "http://127.0.0.1:11434"
dialect  = "ollama"

# The hosted providers below are the long form. 'lmrelay provider add openai
# sk-...' writes the same three fields into state.json in four words. Keep an
# upstream here when you want its key read from the environment at startup,
# which is what the ${VAR} in each header does.
#
# They ship commented out so that a freshly written config starts: an unset
# ${VAR} is a startup error, and every one of them would be unset on a machine
# that has just run 'lmrelay init'. Uncomment a block once its variable is
# exported.

# OpenAI. Wants a bearer token.
# [upstream.openai]
# base_url = "https://api.openai.com"
# dialect  = "openai"
# headers  = { Authorization = "Bearer ${OPENAI_API_KEY}" }

# Anthropic. Wants x-api-key plus a dated version header, and speaks its
# own dialect on /v1/messages, not /v1/chat/completions.
# [upstream.anthropic]
# base_url = "https://api.anthropic.com"
# dialect  = "anthropic"
# headers  = { "x-api-key" = "${ANTHROPIC_API_KEY}", "anthropic-version" = "2023-06-01" }

# DeepSeek. OpenAI-compatible wire format, bearer token.
# [upstream.deepseek]
# base_url = "https://api.deepseek.com"
# dialect  = "openai"
# headers  = { Authorization = "Bearer ${DEEPSEEK_API_KEY}" }

# Grok (xAI). OpenAI-compatible wire format, bearer token.
# [upstream.grok]
# base_url = "https://api.x.ai"
# dialect  = "openai"
# headers  = { Authorization = "Bearer ${XAI_API_KEY}" }
